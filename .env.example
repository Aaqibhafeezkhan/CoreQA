APP_ENV=local
APP_BASE_URL=/
SESSION_NAME=coreqa_sid
# Optional: CoreQA derives a stable signing key from the database connection when omitted.
CSRF_KEY=
HSTS_ENABLED=1
DB_DSN=sqlite:storage/database.sqlite
DB_USER=
DB_PASS=
# Set automatically by the Vercel Neon integration in deployed environments.
DATABASE_URL=
